<%- include('../layout/header') %>

<div class="topbar">
  <div>
    <h1 class="page-title"><%= company.name %></h1>
    <div class="muted"><%= company.industry || 'Компания' %> · <%= company.address || 'Няма адрес' %></div>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/contacts/companies/<%= company.id %>/edit/">Редакция</a>
    <a class="btn btn-success" href="/contacts/new/?company=<%= company.id %>">Нов контакт</a>
  </div>
</div>

<div class="card-soft p-4">
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <h6 class="fw-bold text-muted small text-uppercase">Индустрия</h6>
      <div><%= company.industry || '—' %></div>
    </div>
    <div class="col-md-6">
      <h6 class="fw-bold text-muted small text-uppercase">Уебсайт</h6>
      <div>
        <% if (company.website) { %>
          <a href="<%= company.website %>" target="_blank" rel="noopener"><%= company.website %></a>
        <% } else { %>
          —
        <% } %>
      </div>
    </div>
    <div class="col-md-6">
      <h6 class="fw-bold text-muted small text-uppercase">Адрес</h6>
      <div><%= company.address || '—' %></div>
    </div>
    <div class="col-md-6">
      <h6 class="fw-bold text-muted small text-uppercase">Отговорен търговец</h6>
      <div><%= company.ownerName %></div>
    </div>
  </div>

  <% if (company.notes) { %>
    <div class="p-3 bg-light rounded mb-4">
      <h6 class="fw-bold small text-muted text-uppercase mb-1">Бележки</h6>
      <p class="muted mb-0"><%= company.notes %></p>
    </div>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
    <h5 class="fw-bold mb-0">Свързани контакти (<%= company.contacts.length %>)</h5>
    <a class="btn btn-sm btn-outline-success" href="/contacts/new/?company=<%= company.id %>">+ Нов контакт</a>
  </div>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Име</th>
          <th>Длъжност</th>
          <th>Имейл</th>
          <th>Телефон</th>
        </tr>
      </thead>
      <tbody>
      <% if (company.contacts && company.contacts.length > 0) { %>
        <% company.contacts.forEach(function(c) { %>
          <tr>
            <td><a href="/contacts/<%= c.id %>/" class="fw-semibold text-decoration-none"><%= c.fullName %></a></td>
            <td><%= c.position || '—' %></td>
            <td><%= c.email %></td>
            <td><%= c.phone || '—' %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="4" class="muted py-3">Няма свързани лица в тази компания.</td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layout/footer') %>
