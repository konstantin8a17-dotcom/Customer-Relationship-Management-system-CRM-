<%- include('../layout/header') %>

<div class="topbar">
  <div>
    <h1 class="page-title">Потребители</h1>
    <div class="muted">Администрация на търговски представители и роли.</div>
  </div>
  <a class="btn btn-success" href="/accounts/users/new/">Нов потребител</a>
</div>

<div class="card-soft">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Потребителско име</th>
          <th>Име и фамилия</th>
          <th>Роля</th>
          <th>Имейл</th>
          <th>Телефон</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
      <% users.forEach(function(u) { %>
        <tr>
          <td class="fw-semibold"><%= u.username %></td>
          <td><%= u.firstName %> <%= u.lastName %></td>
          <td>
            <% if (u.role === 'admin' || u.isSuperuser) { %>
              <span class="badge bg-danger">Администратор</span>
            <% } else { %>
              <span class="badge bg-primary">Търговски представител</span>
            <% } %>
          </td>
          <td><a href="mailto:<%= u.email %>" class="text-muted"><%= u.email %></a></td>
          <td><%= u.phone || '—' %></td>
          <td>
            <a href="/accounts/switch?user=<%= u.username %>" class="btn btn-sm btn-outline-secondary">Влез като</a>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layout/footer') %>
