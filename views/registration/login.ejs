<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Вход · Sales CRM</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="/static/css/crm.css" rel="stylesheet">
</head>
<body>
<div class="login-wrap">
  <div class="login-card card-soft bg-white">
    <div class="d-flex align-items-center gap-2 mb-3">
      <div class="brand-mark">C</div>
      <h1 class="h3 mb-0 fw-bold">Sales CRM</h1>
    </div>
    <p class="muted mb-4">Влезте като администратор или търговски представител.</p>
    
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form method="post" action="/accounts/login/">
      <div class="mb-3">
        <label class="form-label">Потребителско име</label>
        <input type="text" name="username" class="form-control" placeholder="Потребителско име" value="<%= username || '' %>" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label">Парола</label>
        <input type="password" name="password" class="form-control" placeholder="Парола" required>
      </div>
      <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Вход</button>
    </form>

    <div class="mt-4 pt-3 border-top">
      <div class="small fw-bold text-muted mb-2">Бърз вход с демо акаунти:</div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/accounts/switch?user=admin" class="btn btn-sm btn-outline-dark">👑 Админ (admin)</a>
        <a href="/accounts/switch?user=ivan" class="btn btn-sm btn-outline-primary">💼 Иван (ivan)</a>
        <a href="/accounts/switch?user=maria" class="btn btn-sm btn-outline-info">💼 Мария (maria)</a>
      </div>
      <p class="muted small mt-2 mb-0">Пароли: <code>Admin12345</code> (админ), <code>Demo12345</code> (търговци)</p>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
