<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Вход · Sales CRM</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="/static/css/crm.css" rel="stylesheet">
  <style>
    .credential-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      margin-bottom: 0.75rem;
      cursor: pointer;
      transition: all 0.15s ease-in-out;
    }
    .credential-box:hover {
      background: #f1f5f9;
      border-color: #cbd5e1;
    }
  </style>
</head>
<body>
<div class="login-wrap">
  <div class="login-card card-soft bg-white" style="max-width: 480px; width: 100%;">
    <div class="d-flex align-items-center gap-2 mb-2">
      <div class="brand-mark">C</div>
      <h1 class="h3 mb-0 fw-bold">Sales CRM</h1>
    </div>
    <p class="muted mb-3">Влезте в системата за управление на продажби.</p>

    <% if (currentUser) { %>
      <div class="alert alert-info py-2 d-flex justify-content-between align-items-center mb-3">
        <div>
          <small class="d-block text-muted">В момента сте влезли като:</small>
          <strong><%= (currentUser.firstName + ' ' + currentUser.lastName).trim() || currentUser.username %></strong> (<%= currentUser.role === 'admin' ? 'Админ' : 'Търговец' %>)
        </div>
        <a href="/" class="btn btn-sm btn-primary fw-semibold">Към таблото &rarr;</a>
      </div>
    <% } %>
    
    <% if (error) { %>
      <div class="alert alert-danger py-2"><%= error %></div>
    <% } %>

    <form method="post" action="/accounts/login/" id="loginForm">
      <div class="mb-3">
        <label class="form-label fw-semibold">Потребителско име</label>
        <input type="text" id="usernameInput" name="username" class="form-control" placeholder="admin или ivan" value="<%= username || '' %>" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Парола</label>
        <div class="input-group">
          <input type="password" id="passwordInput" name="password" class="form-control" placeholder="Въведете парола" required>
          <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn" onclick="togglePasswordVisibility()" title="Покажи/скрий паролата">👁️</button>
        </div>
      </div>
      <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Вход</button>
    </form>

    <div class="mt-4 pt-3 border-top">
      <div class="small fw-bold text-dark mb-2">Директен вход с 1 клик (без писане):</div>
      <div class="d-flex flex-column gap-2 mb-3">
        <div class="credential-box d-flex justify-content-between align-items-center" onclick="directLogin('admin')">
          <div>
            <strong>👑 Администратор</strong>
            <div class="small text-muted">потребител: <code>admin</code> &middot; парола: <code>Admin12345</code></div>
          </div>
          <a href="/accounts/switch?user=admin" class="btn btn-sm btn-dark">Влез</a>
        </div>

        <div class="credential-box d-flex justify-content-between align-items-center" onclick="directLogin('ivan')">
          <div>
            <strong>💼 Търговец (Иван)</strong>
            <div class="small text-muted">потребител: <code>ivan</code> &middot; парола: <code>Demo12345</code></div>
          </div>
          <a href="/accounts/switch?user=ivan" class="btn btn-sm btn-primary">Влез</a>
        </div>

        <div class="credential-box d-flex justify-content-between align-items-center" onclick="directLogin('maria')">
          <div>
            <strong>💼 Търговец (Мария)</strong>
            <div class="small text-muted">потребител: <code>maria</code> &middot; парола: <code>Demo12345</code></div>
          </div>
          <a href="/accounts/switch?user=maria" class="btn btn-sm btn-info text-white">Влез</a>
        </div>
      </div>

      <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary w-50" onclick="fillForm('admin', 'Admin12345')">Попълни Админ</button>
        <button type="button" class="btn btn-sm btn-outline-secondary w-50" onclick="fillForm('ivan', 'Demo12345')">Попълни Иван</button>
      </div>
    </div>
  </div>
</div>

<script>
  function togglePasswordVisibility() {
    const input = document.getElementById('passwordInput');
    const btn = document.getElementById('togglePasswordBtn');
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🔒';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  }

  function fillForm(user, pass) {
    document.getElementById('usernameInput').value = user;
    document.getElementById('passwordInput').value = pass;
  }

  function directLogin(user) {
    window.location.href = '/accounts/switch?user=' + encodeURIComponent(user);
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
